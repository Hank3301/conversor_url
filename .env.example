# Copie para .env e ajuste. Nada aqui é obrigatório para rodar localmente.

# --- Limites de uso (proteção do host gratuito) ---
MAX_DURATION_MINUTES=45
MAX_FILESIZE_MB=2048
MAX_CONCURRENT_JOBS=2
JOB_TTL_MINUTES=30

# --- Rate limit por IP ---
RESOLVE_PER_MINUTE=10
DOWNLOADS_PER_10MIN=3

# --- Cotas de qualidade ---
MAX_HEIGHT=2160

# --- CORS: preencha só se o frontend ficar em outro domínio ---
# FRONTEND_ORIGIN=https://seu-site.pages.dev

# --- Cookies (YouTube/Instagram). Gere com: python scripts/cookies_b64.py cookies.txt ---
# COOKIES_B64=

# --- Opcional: proxy residencial para o YouTube ---
# PROXY_URL=
